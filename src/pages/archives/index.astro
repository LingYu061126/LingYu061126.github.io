---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="归档"><section class="content-shell page-head"><p class="eyebrow">ARCHIVES</p><h1>文章归档</h1><PostList posts={posts} /></section></BaseLayout>
