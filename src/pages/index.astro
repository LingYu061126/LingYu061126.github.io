---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_SUBTITLE } from '../consts';
import { siteConfig } from '../config';
import ProfileCard from '../components/ProfileCard.astro';
import Pagination from '../components/Pagination.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.tags.includes('碎碎念')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pageSize = siteConfig.features.postsPerPage;
const totalPages = Math.ceil(posts.length / pageSize);
---
<BaseLayout>
  {siteConfig.features.showBanner && siteConfig.banner.enable && <section class="hero-banner" style={`background-image:linear-gradient(180deg,transparent 35%,rgba(20,18,30,.58)),url('${siteConfig.banner.image}');background-position:${siteConfig.banner.position}`}>
    <div><p><span class="typed-subtitle" data-text={SITE_SUBTITLE}>{SITE_SUBTITLE}</span><span class="typed-cursor" aria-hidden="true">|</span></p><h1>{siteConfig.title}</h1><span>{SITE_DESCRIPTION}</span></div>
  </section>}
  <div class="home-grid content-shell-wide">
    {siteConfig.features.showProfile && <div class="sidebar-column"><button class="sidebar-toggle" type="button" aria-label="收起侧栏" aria-expanded="true">‹</button><ProfileCard /></div>}
    <section class="feed-column">
      <div class="section-heading"><h2>最近文章</h2><a href="/archives/">查看全部 →</a></div>
      <PostList posts={posts.slice(0, pageSize)} />
      <Pagination currentPage={1} totalPages={totalPages} />
    </section>
  </div>
</BaseLayout>
