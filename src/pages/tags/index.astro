---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await getCollection('posts', ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---
<BaseLayout title="标签"><section class="content-shell page-head"><p class="eyebrow">TAGS</p><h1>文章标签</h1><div class="tag-cloud">{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}<small>{posts.filter((p) => p.data.tags.includes(tag)).length}</small></a>)}</div></section></BaseLayout>
