---
import { siteConfig } from '../config';
import { getCollection } from 'astro:content';
const { profile, author, description, social } = siteConfig;
const posts = await getCollection('posts', ({ data }) => !data.draft);
const categories = new Set(posts.flatMap((post) => post.data.categories));
const tags = new Set(posts.flatMap((post) => post.data.tags));
const categoryList = [...categories]
  .filter((name) => name !== '迷思')
  .map((name) => ({ name, count: posts.filter((post) => post.data.categories.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
const tagList = [...tags]
  .map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---
<div class="sidebar-cards">
  <aside class="profile-card glass-card">
    <img class="profile-avatar" src={profile.avatar} alt={`${author}的头像`} />
    <h2>{author}</h2>
    <p class="profile-description">{description}</p>
    <p class="profile-bio">{profile.bio}</p>
    <div class="profile-stats">
      <a href="/archives/"><strong>{posts.length}</strong><span>文章</span></a>
      <a href="/categories/"><strong>{categories.size}</strong><span>分类</span></a>
      <a href="/tags/"><strong>{tags.size}</strong><span>标签</span></a>
    </div>
    <div class="profile-links">
      {social.map((item) => <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined}>{item.label}</a>)}
    </div>
  </aside>

  <aside class="sidebar-list-card glass-card">
    <div class="sidebar-card-title"><strong>分类</strong><a href="/categories/">全部 →</a></div>
    <div class="category-list">
      {categoryList.map((category) => <a href={`/categories/${encodeURIComponent(category.name)}/`}><span>{category.name}</span><small>{category.count}</small></a>)}
    </div>
  </aside>

  <aside class="sidebar-list-card glass-card">
    <div class="sidebar-card-title"><strong>标签</strong><a href="/tags/">全部 →</a></div>
    <div class="sidebar-tag-list">
      {tagList.map((tag) => <a href={`/tags/${encodeURIComponent(tag.name)}/`}><span>#{tag.name}</span><small>{tag.count}</small></a>)}
    </div>
  </aside>

  {siteConfig.features.showVisitorStats && <aside class="sidebar-list-card site-stats glass-card">
    <div class="sidebar-card-title"><strong>站点统计</strong></div>
    <div><span>访客数</span><strong id="busuanzi_site_uv">--</strong></div>
    <div><span>访问量</span><strong id="busuanzi_site_pv">--</strong></div>
  </aside>}
</div>
