---
interface Props { currentPage: number; totalPages: number }
const { currentPage, totalPages } = Astro.props;
const hrefFor = (page: number) => page === 1 ? '/' : `/page/${page}/`;
---
{totalPages > 1 && <nav class="pagination glass-card" aria-label="文章分页">
  {currentPage > 1 ? <a href={hrefFor(currentPage - 1)}>← 上一页</a> : <span />}
  <div>{Array.from({ length: totalPages }, (_, index) => index + 1).map((page) =>
    page === currentPage ? <strong aria-current="page">{page}</strong> : <a href={hrefFor(page)}>{page}</a>
  )}</div>
  {currentPage < totalPages ? <a href={hrefFor(currentPage + 1)}>下一页 →</a> : <span />}
</nav>}
