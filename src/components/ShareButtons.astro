---
import { siteConfig } from '../config';
interface Props { path: string; title: string }
const { path, title } = Astro.props;
const url = new URL(path, siteConfig.siteUrl).href;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---
<section class="article-share glass-card" data-share data-url={url} data-title={title}>
  <strong>分享文章</strong>
  <div>
    <button type="button" data-native-share>系统分享</button>
    <a href={`https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer">微博</a>
    <a href={`https://connect.qq.com/widget/shareqq/index.html?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer">QQ</a>
    <button type="button" data-copy-link>复制链接</button>
  </div>
</section>
<script>
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-share]').forEach((share) => {
    if (share.dataset.initialized) return;
    share.dataset.initialized = 'true';
    const url = share.dataset.url ?? location.href;
    const title = share.dataset.title ?? document.title;
    share.querySelector<HTMLButtonElement>('[data-native-share]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (navigator.share) await navigator.share({ title, url }).catch(() => undefined);
      else {
        await navigator.clipboard.writeText(url);
        button.textContent = '链接已复制';
        window.setTimeout(() => { button.textContent = '系统分享'; }, 1600);
      }
    });
    share.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      await navigator.clipboard.writeText(url);
      button.textContent = '已复制';
      window.setTimeout(() => { button.textContent = '复制链接'; }, 1600);
    });
  }));
</script>
