---
import { SITE_DESCRIPTION, SITE_SUBTITLE } from '../consts';
import { siteConfig } from '../config';
---
{siteConfig.features.showBanner && siteConfig.banner.enable && <section
  class="hero-banner"
  style={`background-image:linear-gradient(180deg,transparent 35%,rgba(20,18,30,.58)),url('${siteConfig.banner.image}');background-position:${siteConfig.banner.position}`}
>
  <div>
    <p><span class="typed-subtitle" data-text={SITE_SUBTITLE}>{SITE_SUBTITLE}</span><span class="typed-cursor" aria-hidden="true">|</span></p>
    <h1>{siteConfig.title}</h1>
    <span>{SITE_DESCRIPTION}</span>
  </div>
</section>}
